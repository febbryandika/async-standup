# Postgres. Locally this matches the `db` service in docker-compose.yml;
# in production it is the Neon connection string.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/async_standup

# Docker Compose only — not read by the app. Set this if something already
# owns port 5432 on your machine, and change the port in DATABASE_URL to match.
# DB_PORT=5433

# Better Auth. Generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Resend — the daily digest sender.
RESEND_API_KEY=
DIGEST_FROM=standup@yourdomain.com

# Shared secret for the Vercel Cron target at /api/cron/digest.
CRON_SECRET=

# Demo account. NEXT_PUBLIC_DEMO_EMAIL drives the "Use demo account" button on
# the login page — leave it unset in real deploys. DEMO_PASSWORD is read by the
# seed script only.
NEXT_PUBLIC_DEMO_EMAIL=demo@example.com
DEMO_PASSWORD=demo1234
